# SmartCrop AI backend configuration template.
# Copy to backend/.env and fill in your own values:   copy .env.example .env
# backend/.env is git-ignored. Never commit it, and never put real values in this file.

# REQUIRED. SQLAlchemy URL of your MySQL 8 database (create the database first; tables are
# created by `alembic upgrade head`). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=mysql+pymysql://your_db_user:your_db_password@localhost:3306/smartcrop_ai

# REQUIRED. Secret used to sign login tokens, at least 32 characters. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# Optional (defaults shown).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Frontend origins allowed to call the API, written as a JSON list
# (a plain comma-separated value is rejected by the settings loader when read from .env).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional. Free-text label for the running environment.
ENVIRONMENT=development

# Optional. Override where datasets and trained models are read from
# (defaults: ../dataset and ./trained_models).
# DATASET_DIR=
# MODELS_DIR=

# Weather lookups use Open-Meteo (https://open-meteo.com): the historical archive for the crop form and past selling dates, the forecast
# for selling dates up to 15 days ahead, and SoilGrids (https://soilgrids.org) for soil. The free endpoints need no key (non-commercial
# use only; the server just needs internet access). Optional: set a commercial Open-Meteo key to use the customer-*.open-meteo.com
# endpoints instead. Leave it empty for the free endpoints. Never commit a real key.
OPEN_METEO_API_KEY=
